# --- Chạy local với `npm run dev` (gọi Gemini trực tiếp) ---
# Điền key nếu muốn test AI ngay trên trình duyệt (chỉ dùng cho máy cá nhân).
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# --- Chạy với `vercel dev` hoặc deploy Vercel (server giữ key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Domain bổ sung được phép gọi API (phân tách bằng dấu phẩy).
# Yêu cầu cùng domain luôn được phép; request không có Origin sẽ bị từ chối.
# ALLOWED_ORIGINS=https://your-domain.vercel.app
