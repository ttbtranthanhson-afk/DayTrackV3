# API key Gemini (có thể nhập nhiều key, phân tách bằng dấu phẩy để dự phòng khi hết quota)
VITE_GEMINI_API_KEY=
VITE_GEMINI_API_KEYS=
# Danh sách model ưu tiên (phân tách bằng dấu phẩy). Tự động chuyển model tiếp theo khi hết quota.
VITE_GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# Dùng cho máy chủ proxy Vercel (api/ai.ts)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
